<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ManorLord</AssemblyName>
    <RootNamespace>ManorLord</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
    <BannerlordPath>$(MSBuildProjectDirectory)\..\..\..</BannerlordPath>
    <BannerlordBin>$(BannerlordPath)\bin\Win64_Shipping_Client</BannerlordBin>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Bannerlord 1.3.15 build has its own project that compiles these same sources. -->
    <Compile Remove="compat-1.3.15\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TaleWorlds.CampaignSystem"><HintPath>$(BannerlordBin)\TaleWorlds.CampaignSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core"><HintPath>$(BannerlordBin)\TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(BannerlordBin)\TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Localization"><HintPath>$(BannerlordBin)\TaleWorlds.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(BannerlordBin)\TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ObjectSystem"><HintPath>$(BannerlordBin)\TaleWorlds.ObjectSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.DotNet"><HintPath>$(BannerlordBin)\TaleWorlds.DotNet.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine"><HintPath>$(BannerlordBin)\TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.InputSystem"><HintPath>$(BannerlordBin)\TaleWorlds.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CopyToEditorRuntime" AfterTargets="Build">
    <MakeDir Directories="..\bin\Win64_Shipping_wEditor" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\bin\Win64_Shipping_wEditor" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="..\bin\Win64_Shipping_wEditor" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
