<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AlternateStart for Bannerlord v1.3.15. Compiles the same sources as ../AlternateStart.csproj, but against the game's
    published 1.3.15 reference assemblies instead of the installed (1.4.8) game, so it builds without that version
    installed. Code that differs between the two versions is fenced with #if BANNERLORD_1_3.
    Build:   dotnet build -c Release   (in this folder)
    Output:  obj/out/AlternateStart.dll
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AlternateStart</AssemblyName>
    <RootNamespace>AlternateStart</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>obj\out\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);BANNERLORD_1_3</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.3.15.110062" PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>
</Project>
